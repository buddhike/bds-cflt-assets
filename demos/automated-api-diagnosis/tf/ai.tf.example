# THE AI AGENT: YOURS TO DEFINE.
#
# The demo works without this file: the simulator, the Flink anomaly detection and the
# service health monitor all run, and the AI reports tab says no agent is deployed. This
# file is where the agent that diagnoses each anomaly goes. The source demo ran it by
# hand in a Flink workspace and kept no definition, so there was none to carry over.
#
# To turn it on:
#
#   1. Copy this file to ai.tf (Terraform reads only *.tf) and replace every TODO.
#   2. Set the default of variable "ai_agent_deployed" in variables.tf to true. That
#      only changes what the AI reports tab says while it is still empty.
#   3. Commit both, and launch the demo again.
#
# What the app needs from you is the INSERT at the bottom. The table it writes to,
# api_anomaly_ai_reports, already exists (flink.tf), with these columns, all NOT NULL:
#
#   api_id STRING, http_status STRING, detected_at TIMESTAMP_LTZ(3),
#   agent_status STRING, report STRING
#
# `report` is Markdown, shown in the UI. Anything the model wraps in <reasoning>...
# </reasoning> is removed before it is shown. Write one row per anomaly, not one per
# 10-second window: api_unhealthy_events carries a row for each API that turns
# unhealthy (is_anomaly = TRUE) and one for each that recovers (is_anomaly = FALSE),
# with a row per HTTP status code that contributed. Read it from its tail
# (scan.startup.mode = latest-offset), which is its table default.
#
# Everything below is a working shape, not a recommendation. It is the pattern from
# Confluent's streaming agents: a connection to an LLM, a model on it, an agent on the
# model, and AI_RUN_AGENT called from a streaming INSERT. Change the provider, the
# model, the prompt, the tools, the columns you pass the agent.
#
# Launchpad passes no variables except its own, so a credential has to come from this
# Terraform. Here an IAM user that may only invoke the model makes one. Its key is in
# Terraform's state, in Launchpad's bucket, like the other secrets this demo makes. Do
# not put a credential in this file.

locals {
  # TODO: the model, and the region it is in. Bedrock needs model access enabled in the
  # AWS account first.
  bedrock_model_id = "global.anthropic.claude-haiku-4-5-20251001-v1:0"
  bedrock_region   = var.aws_region
}

data "aws_iam_policy_document" "invoke_model" {
  statement {
    actions   = ["bedrock:InvokeModel"]
    resources = ["*"]
  }
}

resource "aws_iam_user" "flink_llm" {
  name          = "${local.name}-flink-llm"
  force_destroy = true
}

resource "aws_iam_user_policy" "flink_llm" {
  name   = "invoke-model"
  user   = aws_iam_user.flink_llm.name
  policy = data.aws_iam_policy_document.invoke_model.json
}

resource "aws_iam_access_key" "flink_llm" {
  user = aws_iam_user.flink_llm.name
}

resource "confluent_flink_connection" "llm" {
  display_name = "${local.name}-llm"
  type         = "BEDROCK"

  endpoint      = "https://bedrock-runtime.${local.bedrock_region}.amazonaws.com/model/${local.bedrock_model_id}/invoke"
  rest_endpoint = data.confluent_flink_region.demo.rest_endpoint

  aws_access_key = aws_iam_access_key.flink_llm.id
  aws_secret_key = aws_iam_access_key.flink_llm.secret

  environment {
    id = confluent_environment.demo.id
  }
  organization {
    id = data.confluent_organization.this.id
  }
  credentials {
    key    = confluent_api_key.flink.id
    secret = confluent_api_key.flink.secret
  }
  compute_pool {
    id = confluent_flink_compute_pool.demo.id
  }
  principal {
    id = confluent_service_account.demo.id
  }

  depends_on = [confluent_role_binding.flink_admin, aws_iam_user_policy.flink_llm]
}

resource "confluent_flink_statement" "ai_model" {
  statement_name = "${local.name}-ai-model"
  statement      = <<-SQL
    CREATE MODEL api_diagnosis_model
    INPUT (prompt STRING)
    OUTPUT (response STRING)
    WITH (
      'provider' = 'bedrock',
      'task' = 'text_generation',
      'bedrock.connection' = '${confluent_flink_connection.llm.display_name}',
      'bedrock.params.max_tokens' = '2048'
    )
  SQL
  properties     = local.flink_properties

  compute_pool { id = confluent_flink_compute_pool.demo.id }
  principal { id = confluent_service_account.demo.id }
  environment { id = confluent_environment.demo.id }
  organization { id = data.confluent_organization.this.id }
  credentials {
    key    = confluent_api_key.flink.id
    secret = confluent_api_key.flink.secret
  }
  rest_endpoint = data.confluent_flink_region.demo.rest_endpoint
}

resource "confluent_flink_statement" "ai_agent" {
  statement_name = "${local.name}-ai-agent"
  statement      = <<-SQL
    CREATE AGENT api_diagnosis_agent
    USING MODEL api_diagnosis_model
    USING PROMPT 'TODO: who the agent is, what it is given, what it must produce.
    It is given an API gateway anomaly: the API, the HTTP status that rose, the
    unhealthy rate against its forecast and bounds. Answer in Markdown.'
    WITH (
      'max_iterations' = '5'
    )
  SQL
  properties     = local.flink_properties

  compute_pool { id = confluent_flink_compute_pool.demo.id }
  principal { id = confluent_service_account.demo.id }
  environment { id = confluent_environment.demo.id }
  organization { id = data.confluent_organization.this.id }
  credentials {
    key    = confluent_api_key.flink.id
    secret = confluent_api_key.flink.secret
  }
  rest_endpoint = data.confluent_flink_region.demo.rest_endpoint

  depends_on = [confluent_flink_statement.ai_model]
}

# AI_RUN_AGENT(agent name, prompt, request id): the prompt supplements the agent's own.
# Its answer is `response`. The request id must differ for every call.
resource "confluent_flink_statement" "ai_reports" {
  statement_name = "${local.name}-ai-reports"
  statement      = <<-SQL
    INSERT INTO api_anomaly_ai_reports (api_id, http_status, detected_at, agent_status, report)
    SELECT
      e.api_id,
      e.http_status,
      e.detected_at,
      r.status,
      COALESCE(r.response, 'The agent returned nothing.')
    FROM api_unhealthy_events AS e,
    LATERAL TABLE(AI_RUN_AGENT(
      'api_diagnosis_agent',
      CONCAT(
        'API: ', e.api_id, '\n',
        'HTTP status that rose: ', e.http_status, ' (', CAST(e.status_count AS STRING), ' of ', CAST(e.total_count AS STRING), ' calls)\n',
        'Unhealthy rate: ', CAST(e.unhealthy_rate AS STRING), '\n',
        'Forecast: ', CAST(e.forecast_value AS STRING), ' (', CAST(e.lower_bound AS STRING), ' to ', CAST(e.upper_bound AS STRING), ')'
      ),
      CONCAT(e.api_id, '-', e.http_status, '-', CAST(e.detected_at AS STRING))
    )) AS r(status, response)
    WHERE e.is_anomaly = TRUE
  SQL
  properties     = local.flink_properties

  compute_pool { id = confluent_flink_compute_pool.demo.id }
  principal { id = confluent_service_account.demo.id }
  environment { id = confluent_environment.demo.id }
  organization { id = data.confluent_organization.this.id }
  credentials {
    key    = confluent_api_key.flink.id
    secret = confluent_api_key.flink.secret
  }
  rest_endpoint = data.confluent_flink_region.demo.rest_endpoint

  depends_on = [
    confluent_flink_statement.ai_agent,
    confluent_flink_statement.create_anomaly_reports,
    confluent_flink_statement.detect_anomalies,
  ]
}
