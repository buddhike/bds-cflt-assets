# Lightning inventory as a Launchpad demo: a Confluent Cloud Lightning Table over a topic of
# inventory positions, queried by a load generator in ECS. See ../docs/specs/launchpad.md.

terraform {
  required_version = ">= 1.10.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    confluent = {
      source  = "confluentinc/confluent"
      version = "~> 2.90"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
    time = {
      source  = "hashicorp/time"
      version = "~> 0.11"
    }
  }
}

provider "aws" {
  region = var.aws_region

  # Launchpad's tags go on everything that takes tags.
  default_tags {
    tags = var.launchpad_tags
  }
}

provider "confluent" {
  cloud_api_key    = var.confluent_cloud_api_key
  cloud_api_secret = var.confluent_cloud_api_secret
}
